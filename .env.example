# Copy to .env or export these variables before running `npm start`
PORT=3000
# Optional: fixed secret for login tokens (otherwise one is generated and saved in data/.jwt-secret)
JWT_SECRET=
# Optional: TURN server so calls work behind strict firewalls / mobile networks
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# Optional: "Continue with Google" button (see README for how to get a client id)
GOOGLE_CLIENT_ID=

# Account recovery codes by EMAIL (any SMTP service: Gmail app password, Brevo, Mailgun, SendGrid...)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Connectly <no-reply@yourdomain.com>"

# Account recovery codes by TEXT MESSAGE (Twilio). TWILIO_FROM is your Twilio number or a Messaging Service SID
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Set to "production" on your live server (stops codes from being printed in the server console)
NODE_ENV=
